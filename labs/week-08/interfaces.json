{
  "ietf-interfaces:interfaces": {
    "interface": [
      {
        "name": "eth1",
        "description": "uplink to the core",
        "type": "iana-if-type:ethernetCsmacd",
        "enabled": true,
        "ietf-ip:ipv4": {
          "address": [
            {"ip": "10.7.1.1", "prefix-length": 24}
          ]
        }
      },
      {
        "name": "lo0",
        "type": "iana-if-type:softwareLoopback",
        "ietf-ip:ipv4": {
          "address": [
            {"ip": "10.7.255.1", "prefix-length": 32}
          ]
        }
      }
    ]
  }
}
